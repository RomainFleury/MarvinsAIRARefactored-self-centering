<UserControl x:Class="MarvinsAIRARefactored.Pages.ExperimentalWheelPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:MarvinsAIRARefactored.Controls"
             xmlns:datacontext="clr-namespace:MarvinsAIRARefactored.DataContext"
             mc:Ignorable="d"
             d:DesignWidth="800"
             Unloaded="Root_Unloaded">

    <UserControl.DataContext>
        <Binding Source="{x:Static datacontext:DataContext.Instance}" />
    </UserControl.DataContext>

    <StackPanel>

        <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                   TextWrapping="Wrap"
                   Foreground="#bbb"
                   Margin="0,0,0,16"
                   Text="{Binding Localization[ExperimentalWheelIntro]}" />

        <Border Background="#331a1a"
                BorderBrush="#663333"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,20">

            <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                       TextWrapping="Wrap"
                       Foreground="#ffaaaa"
                       Text="{Binding Localization[ExperimentalWheelExclusiveFFBWarning]}" />
        </Border>

        <controls:MairaGroupBox Label="{Binding Localization[ExperimentalWheelDevice_UC]}"
                                Margin="0,0,0,20">

            <StackPanel>

                <controls:MairaComboBox x:Name="ExperimentalSteeringDevice_MairaComboBox"
                                        Label="{Binding Localization[SteeringDevice]}"
                                        SelectedValue="{Binding Settings.RacingWheelSteeringDeviceGuid, Mode=TwoWay}"
                                        SelectionChanged="ExperimentalSteeringDevice_MairaComboBox_SelectionChanged" />

                <TextBlock x:Name="SelectedSteeringDevice_TextBlock"
                           Style="{StaticResource MairaTextBlockStyle}"
                           TextWrapping="Wrap"
                           Foreground="#cccccc"
                           Margin="0,10,0,0"
                           FontSize="18" />

                <TextBlock x:Name="SteeringAxisLive_TextBlock"
                           Style="{StaticResource MairaTextBlockStyle}"
                           TextWrapping="Wrap"
                           Foreground="#aaaaaa"
                           Margin="0,6,0,0"
                           FontSize="18"
                           FontFamily="Consolas" />

            </StackPanel>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox Label="{Binding Localization[ExperimentalWheelSession_UC]}">

            <StackPanel>

                <controls:MairaSwitch x:Name="SessionActive_MairaSwitch"
                                      Label="{Binding Localization[ExperimentalWheelSessionActive]}"
                                      Toggled="SessionActive_MairaSwitch_Toggled" />

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           TextWrapping="Wrap"
                           Foreground="#888"
                           Margin="0,10,0,0"
                           Text="{Binding Localization[ExperimentalWheelSessionHint]}" />

            </StackPanel>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox Label="{Binding Localization[ExperimentalWheelTuning_UC]}"
                                Margin="0,20,0,0">

            <StackPanel>

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           TextWrapping="Wrap"
                           Foreground="#888"
                           Margin="0,0,0,10"
                           Text="{Binding Localization[ExperimentalWheelTuningHint]}" />

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:MairaKnob Grid.Column="0"
                                        Label="{Binding Localization[WheelCenteringStrength]}"
                                        Value="{Binding Settings.RacingWheelWheelCenteringStrength, Mode=TwoWay}"
                                        ValueString="{Binding Settings.RacingWheelWheelCenteringStrengthString}"
                                        StepSize="0.01"
                                        ContextSwitches="{Binding Settings.RacingWheelWheelCenteringStrengthContextSwitches}"
                                        PlusButtonMappings="{Binding Settings.RacingWheelWheelCenteringStrengthPlusButtonMappings}"
                                        MinusButtonMappings="{Binding Settings.RacingWheelWheelCenteringStrengthMinusButtonMappings}"
                                        DefaultValue="0.75" />

                    <controls:MairaSwitch Grid.Column="2"
                                          VerticalAlignment="Center"
                                          Label="{Binding Localization[ExperimentalWheelSoftLockEnabled]}"
                                          IsOn="{Binding Settings.ExperimentalWheelSoftLockEnabled, Mode=TwoWay}" />

                </Grid>

                <Grid Margin="0,16,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:MairaKnob Grid.Column="0"
                                        Label="{Binding Localization[ExperimentalWheelSoftLockStrength]}"
                                        Value="{Binding Settings.ExperimentalWheelSoftLockStrength, Mode=TwoWay}"
                                        ValueString="{Binding Settings.ExperimentalWheelSoftLockStrengthString}"
                                        StepSize="0.01"
                                        ContextSwitches="{Binding Settings.ExperimentalWheelSoftLockStrengthContextSwitches}"
                                        PlusButtonMappings="{Binding Settings.ExperimentalWheelSoftLockStrengthPlusButtonMappings}"
                                        MinusButtonMappings="{Binding Settings.ExperimentalWheelSoftLockStrengthMinusButtonMappings}"
                                        DefaultValue="0.25" />

                    <controls:MairaKnob Grid.Column="2"
                                        Label="{Binding Localization[ExperimentalWheelSoftLockThreshold]}"
                                        Value="{Binding Settings.ExperimentalWheelSoftLockThreshold, Mode=TwoWay}"
                                        ValueString="{Binding Settings.ExperimentalWheelSoftLockThresholdString}"
                                        StepSize="0.01"
                                        ContextSwitches="{Binding Settings.ExperimentalWheelSoftLockThresholdContextSwitches}"
                                        PlusButtonMappings="{Binding Settings.ExperimentalWheelSoftLockThresholdPlusButtonMappings}"
                                        MinusButtonMappings="{Binding Settings.ExperimentalWheelSoftLockThresholdMinusButtonMappings}"
                                        DefaultValue="0.85" />

                </Grid>

            </StackPanel>

        </controls:MairaGroupBox>

    </StackPanel>

</UserControl>
